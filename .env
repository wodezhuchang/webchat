# ============================================
# 数据库配置
# ============================================

# MySQL 主机地址
DB_HOST=localhost

# MySQL 端口
DB_PORT=3308

# 数据库用户名
DB_USER=root

# 数据库密码（请修改为实际密码）
DB_PASSWORD=123456

# 数据库名称
DB_NAME=chat_system

# 连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================
# JWT 配置
# ============================================

# JWT 密钥（请修改为随机字符串）
JWT_SECRET_KEY=your_very_long_and_random_secret_key_here_please_change_this_to_something_secure

# JWT 算法
JWT_ALGORITHM=HS256

# Access Token 有效期（分钟）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token 有效期（天）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# 密码哈希配置
# ============================================

# bcrypt 轮数（建议 12）
BCRYPT_ROUNDS=12
